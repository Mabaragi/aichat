{
  "name": "aichat-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/next-dev.mjs",
    "dev:backend": "node scripts/next-dev.mjs --api-mode=backend",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../docs/api/openapi.json -o src/api/generated/backend-schema.d.ts",
    "check": "npm run generate:api && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "swr": "2.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.9",
    "jsdom": "28.1.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.15",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
